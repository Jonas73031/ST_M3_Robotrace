void Init_UART(void)
{
  USART_InitStructure.USART_BaudRate = 115200;
  USART_InitStructure.USART_WordLength = USART_WordLength_8b;
  USART_InitStructure.USART_StopBits = USART_StopBits_1;
  USART_InitStructure.USART_Parity = USART_Parity_No;
  USART_InitStructure.USART_HardwareFlowControl = USART_HardwareFlowControl_None;
  USART_InitStructure.USART_Mode = USART_Mode_Rx | USART_Mode_Tx;

  USART_Init(UART4, &USART_InitStructure); // ��l�� UART4

  USART_Cmd(UART4, ENABLE); // �ҥ� USART4
}

void Uart_Num(unsigned long Value)
{
	unsigned long Num;
	Num = (Value/100000)%10+48;
	Uart_Sent(Num);
	Num = (Value/10000)%10+48;
	Uart_Sent(Num);
	Num = (Value/1000)%10+48;
	Uart_Sent(Num);
	Num = (Value/100)%10+48;
	Uart_Sent(Num);
	Num = (Value/10)%10+48;
	Uart_Sent(Num);
	Num = (Value)%10+48;
	Uart_Sent(Num);

	USART_SendData(UART4,(char)'\t');
	while (USART_GetFlagStatus(UART4, USART_FLAG_TC) == RESET);		
}

void Uart_Sent(unsigned long num)
{
	unsigned long Sent;
	Sent=num;
	USART_SendData(UART4,Sent);
	while (USART_GetFlagStatus(UART4, USART_FLAG_TC) == RESET);
}

void Init_ADC(void)
{
	ADC_DeInit(ADC1);
	
	ADC_InitStructure.ADC_Mode = ADC_Mode_Independent;
  ADC_InitStructure.ADC_ScanConvMode = DISABLE;
  ADC_InitStructure.ADC_ContinuousConvMode = DISABLE;
  ADC_InitStructure.ADC_ExternalTrigConv = ADC_ExternalTrigConv_None;
  ADC_InitStructure.ADC_DataAlign = ADC_DataAlign_Right;
  ADC_InitStructure.ADC_NbrOfChannel = 1;
  ADC_Init(ADC1, &ADC_InitStructure);
  
  /* Enable ADC1 */
  ADC_Cmd(ADC1, ENABLE);
  /* Enable ADC1 reset calibaration register */   
  ADC_ResetCalibration(ADC1);
  /* Check the end of ADC1 reset calibration register */
  while(ADC_GetResetCalibrationStatus(ADC1));
  /* Start ADC1 calibaration */
  ADC_StartCalibration(ADC1);
  /* Check the end of ADC1 calibration */
  while(ADC_GetCalibrationStatus(ADC1));
}

void Init_BUZZER(void)
{
	TIM_TimeBaseStructure.TIM_Period = (36000000/2)/Do-1;
	TIM_TimeBaseStructure.TIM_Prescaler = 3;
  TIM_TimeBaseStructure.TIM_ClockDivision = TIM_CKD_DIV1;
  TIM_TimeBaseStructure.TIM_CounterMode = TIM_CounterMode_Up;
  TIM_TimeBaseStructure.TIM_RepetitionCounter = 0;
  TIM_TimeBaseInit(TIM5, &TIM_TimeBaseStructure);

  TIM_OCInitStructure.TIM_OCMode = TIM_OCMode_PWM1;
  TIM_OCInitStructure.TIM_OutputState = TIM_OutputState_Enable;
  TIM_OCInitStructure.TIM_OCPolarity =TIM_OCPolarity_High;
  TIM_OCInitStructure.TIM_OCIdleState = TIM_OCIdleState_Set;
  TIM_OC1Init(TIM5, &TIM_OCInitStructure);
	
  TIM_Cmd(TIM5, ENABLE);
}

void BUZZER(void)
{
	if(Buzzer_F==0)
	{
		TIM_Cmd(TIM5, DISABLE);
	}
	else if(Buzzer_F==1)
	{
		TIM5->ARR = (int)(36000000/2)/So-1;
		TIM5->CCR1 = (int)(TIM5->ARR*0.5);
		TIM_Cmd(TIM5, ENABLE);		
		Buzzer_F = 2;
	}
	else if(Buzzer_F==2)
	{
		Buzzer_Time++;
		if( Buzzer_Time >= 50 )
		{
			TIM5->CCR1 = 0;
			Buzzer_Time = 0;
			Buzzer_F = 0;
		}
	}
}

void Init_PWM(void)
{
  TIM_TimeBaseStructure.TIM_Period = 3599;
  TIM_TimeBaseStructure.TIM_Prescaler = 0;	  	
  TIM_TimeBaseStructure.TIM_ClockDivision = TIM_CKD_DIV1;
  TIM_TimeBaseStructure.TIM_CounterMode = TIM_CounterMode_Up;
  TIM_TimeBaseStructure.TIM_RepetitionCounter = 0;
  TIM_TimeBaseInit(TIM8, &TIM_TimeBaseStructure);

  TIM_OCInitStructure.TIM_OCMode = TIM_OCMode_PWM1;
  TIM_OCInitStructure.TIM_OutputState = TIM_OutputState_Enable;
  TIM_OCInitStructure.TIM_OCPolarity =TIM_OCPolarity_High;
  TIM_OCInitStructure.TIM_OCIdleState = TIM_OCIdleState_Set;
  TIM_OC2Init(TIM8, &TIM_OCInitStructure);				   		    	//TIM_8_Channel_2 	(L)
  TIM_OC3Init(TIM8, &TIM_OCInitStructure);				   	 		   	//TIM_8_Channel_3 	(R)
  /* TIM8 counter enable */
  TIM_Cmd(TIM8, ENABLE);
  /* TIM8 Main Output Enable */
  TIM_CtrlPWMOutputs(TIM8, ENABLE);
	
  TIM8->CCR2 = 0;							//PC7
  TIM8->CCR3 = 0;							//PC8
}

void MOTOR_Control(void)
{
	PWM_L = Vc_PD_Command-W_PD_Command;
	PWM_R = Vc_PD_Command+W_PD_Command;
	
	if(PWM_L > 3599)
	{
		PWM_R = PWM_R - (PWM_L - 3599);
		PWM_L = 3599;
	}

	if(PWM_R > 3599)
	{
		PWM_L = PWM_L - (PWM_R - 3599);
		PWM_R = 3599;
	}

	if(PWM_L>=3599)	PWM_L=3599;
	else if(PWM_L<=-3599)	PWM_L=-3599;
	if(PWM_R>=3599)	PWM_R=3599;
	else if(PWM_R<=-3599)	PWM_R=-3599;
	
	if(PWM_L>=0)
	{
		GPIO_ResetBits(GPIOC,GPIO_Pin_6);
	}
	else
	{
		GPIO_SetBits(GPIOC,GPIO_Pin_6);
		PWM_L = (3599 + PWM_L);
	}
	
	if(PWM_R>=0)
	{
		GPIO_ResetBits(GPIOC,GPIO_Pin_9);	
	}
	else
	{
		GPIO_SetBits(GPIOC,GPIO_Pin_9);
		PWM_R = ( 3599 + PWM_R );
	}
	
  TIM8->CCR2 = PWM_L;							//PC7
  TIM8->CCR3 = PWM_R;							//PC8
}

void Init_QEI(void)
{
	TIM_TimeBaseStructure.TIM_Period =0xffff;						   //QEI_L
	TIM_TimeBaseStructure.TIM_Prescaler = 0 ;
	TIM_TimeBaseStructure.TIM_ClockDivision = TIM_CKD_DIV1;
	TIM_TimeBaseStructure.TIM_CounterMode = TIM_CounterMode_Up;
	TIM_TimeBaseInit(TIM3, &TIM_TimeBaseStructure);	
	TIM_EncoderInterfaceConfig(TIM3,TIM_EncoderMode_TI12,TIM_ICPolarity_Rising,TIM_ICPolarity_Rising);

	TIM_Cmd(TIM3, ENABLE);
	
	TIM_TimeBaseStructure.TIM_Period =0xffff;						   //QEI_R
	TIM_TimeBaseStructure.TIM_Prescaler = 0 ;
	TIM_TimeBaseStructure.TIM_ClockDivision = TIM_CKD_DIV1;
	TIM_TimeBaseStructure.TIM_CounterMode = TIM_CounterMode_Up;
	TIM_TimeBaseInit(TIM4, &TIM_TimeBaseStructure);	
	TIM_EncoderInterfaceConfig(TIM4,TIM_EncoderMode_TI12,TIM_ICPolarity_Rising,TIM_ICPolarity_Rising);

	TIM_Cmd(TIM4, ENABLE);

	TIM3->CNT = 0;
	TIM4->CNT = 0;
}

void Encoder(void)
{
	E_L_now = TIM3->CNT;
	E_R_now = TIM4->CNT;
	
	E_L_V = E_L_now-E_L_last;
	E_R_V = E_R_now-E_R_last;
	
	E_L_last = E_L_now;
	E_R_last = E_R_now;
	
	if(E_L_V > 32767)	E_L_V = E_L_V-65536;
	else if(E_L_V < -32767)	E_L_V = E_L_V+65536;
	if(E_R_V > 32767)	E_R_V = E_R_V-65536;
	else if(E_R_V < -32767)	E_R_V = E_R_V+65536;
	
	E_L+=E_L_V;
	E_R+=E_R_V;
	
	MAP_E_L+=E_L_V;
	MAP_E_R+=E_R_V;
}
