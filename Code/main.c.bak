void Wind_MOTER(int Value)
{
	PWM_M = (int)(Value*(3599/100));
	if(PWM_M>3599)
	{
		PWM_M = 3599;
	}
	else if(PWM_M<0)
	{
		PWM_M = 0;
	}
	
	TIM1->CCR1 =PWM_M;
}
