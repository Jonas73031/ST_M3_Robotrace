/*----------------------���]�w---------------------------*/
void Choose(void)
{
	if(E_L>=1000)
	{
		Buzzer_F=1;
		Choose_L++;
		E_L=0;
		if(Choose_L>7)
		{
			Choose_L=0;
		}
	}
	else if(E_L<=-1000)
	{
		Buzzer_F=1;
		Choose_L--;
		E_L=0;
		if(Choose_L<0)
		{
			Choose_L=7;
		}
	}
	
	if(E_R>=1000)
	{
		Buzzer_F=1;
		Choose_R++;
		E_R=0;
		if(Choose_R>5)
		{
			Choose_R=0;
		}
	}
	else if(E_R<=-1000)
	{
		Buzzer_F=1;
		Clear();
		Menu_F=1;
	}
	
	switch(Choose_L)
	{
		case 0:	
						GPIO_SetBits(GPIOC,GPIO_Pin_5);		//L_R
						GPIO_SetBits(GPIOB,GPIO_Pin_0);		//L_G
						GPIO_SetBits(GPIOB,GPIO_Pin_1);		//L_B
						break;
		case 1:	
						GPIO_ResetBits(GPIOC,GPIO_Pin_5);
						GPIO_SetBits(GPIOB,GPIO_Pin_0);
						GPIO_SetBits(GPIOB,GPIO_Pin_1);
						break;
		case 2:
						GPIO_SetBits(GPIOC,GPIO_Pin_5);
						GPIO_ResetBits(GPIOB,GPIO_Pin_0);
						GPIO_SetBits(GPIOB,GPIO_Pin_1);
						break;
		case 3:
						GPIO_SetBits(GPIOC,GPIO_Pin_5);
						GPIO_SetBits(GPIOB,GPIO_Pin_0);
						GPIO_ResetBits(GPIOB,GPIO_Pin_1);
						break;
		case 4:
						GPIO_ResetBits(GPIOC,GPIO_Pin_5);
						GPIO_ResetBits(GPIOB,GPIO_Pin_0);
						GPIO_SetBits(GPIOB,GPIO_Pin_1);
						break;
		case 5:
						GPIO_ResetBits(GPIOC,GPIO_Pin_5);
						GPIO_SetBits(GPIOB,GPIO_Pin_0);
						GPIO_ResetBits(GPIOB,GPIO_Pin_1);
						break;
		case 6:
						GPIO_SetBits(GPIOC,GPIO_Pin_5);
						GPIO_ResetBits(GPIOB,GPIO_Pin_0);
						GPIO_ResetBits(GPIOB,GPIO_Pin_1);
						break;
		case 7:
						GPIO_ResetBits(GPIOC,GPIO_Pin_5);
						GPIO_ResetBits(GPIOB,GPIO_Pin_0);
						GPIO_ResetBits(GPIOB,GPIO_Pin_1);
						break;
	}
	switch(Choose_R)
	{
		case 0:
						GPIO_SetBits(GPIOC,GPIO_Pin_12);	//R_R
						GPIO_SetBits(GPIOD,GPIO_Pin_2);		//R_G
						GPIO_SetBits(GPIOB,GPIO_Pin_5);		//R_B
						break;
		case 1:
						GPIO_ResetBits(GPIOC,GPIO_Pin_12);
						GPIO_SetBits(GPIOD,GPIO_Pin_2);
						GPIO_SetBits(GPIOB,GPIO_Pin_5);
						break;
		case 2:
						GPIO_SetBits(GPIOC,GPIO_Pin_12);
						GPIO_ResetBits(GPIOD,GPIO_Pin_2);
						GPIO_SetBits(GPIOB,GPIO_Pin_5);
						break;
		case 3:
						GPIO_SetBits(GPIOC,GPIO_Pin_12);
						GPIO_SetBits(GPIOD,GPIO_Pin_2);
						GPIO_ResetBits(GPIOB,GPIO_Pin_5);
						break;
		case 4:
						GPIO_ResetBits(GPIOC,GPIO_Pin_12);
						GPIO_ResetBits(GPIOD,GPIO_Pin_2);
						GPIO_SetBits(GPIOB,GPIO_Pin_5);
						break;
		case 5:
						GPIO_ResetBits(GPIOC,GPIO_Pin_12);
						GPIO_SetBits(GPIOD,GPIO_Pin_2);
						GPIO_ResetBits(GPIOB,GPIO_Pin_5);
						break;
		case 6:
						GPIO_SetBits(GPIOC,GPIO_Pin_12);
						GPIO_ResetBits(GPIOD,GPIO_Pin_2);
						GPIO_ResetBits(GPIOB,GPIO_Pin_5);
						break;
		case 7:
						GPIO_ResetBits(GPIOC,GPIO_Pin_12);
						GPIO_ResetBits(GPIOD,GPIO_Pin_2);
						GPIO_ResetBits(GPIOB,GPIO_Pin_5);
						break;
	}
}

/*----------------------���~�u-----------------------------*/
void Catch_ADC(void)
{	
	if(mode==0)
	{
		time++;
		if(time>=1000)
		{
			Buzzer_F=1;
			time=0;
			mode++;
		}
	}
	else if(mode==1)
	{
		if(ADC_Save_F==0)
		{
			IR_ADC_MAX[IR_0]=0;
			IR_ADC_MAX[IR_1]=0;
			IR_ADC_MAX[IR_2]=0;
			IR_ADC_MAX[IR_3]=0;
			IR_ADC_MAX[IR_4]=0;
			IR_ADC_MAX[IR_5]=0;
			IR_ADC_MIN[IR_0]=4095;
			IR_ADC_MIN[IR_1]=4095;
			IR_ADC_MIN[IR_2]=4095;
			IR_ADC_MIN[IR_3]=4095;
			IR_ADC_MIN[IR_4]=4095;
			IR_ADC_MIN[IR_5]=4095;
			ADC_Save_F=1;
		}
		else if(ADC_Save_F==1)
		{
			if(IR_ADC[IR_0]>IR_ADC_MAX[IR_0]){IR_ADC_MAX[IR_0]=IR_ADC[IR_0];}
			else if(IR_ADC[IR_0]<IR_ADC_MIN[IR_0]){IR_ADC_MIN[IR_0]=IR_ADC[IR_0];}
			if(IR_ADC[IR_1]>IR_ADC_MAX[IR_1]){IR_ADC_MAX[IR_1]=IR_ADC[IR_1];}
			else if(IR_ADC[IR_1]<IR_ADC_MIN[IR_1]){IR_ADC_MIN[IR_1]=IR_ADC[IR_1];}
			if(IR_ADC[IR_2]>IR_ADC_MAX[IR_2]){IR_ADC_MAX[IR_2]=IR_ADC[IR_2];}
			else if(IR_ADC[IR_2]<IR_ADC_MIN[IR_2]){IR_ADC_MIN[IR_2]=IR_ADC[IR_2];}
			if(IR_ADC[IR_3]>IR_ADC_MAX[IR_3]){IR_ADC_MAX[IR_3]=IR_ADC[IR_3];}
			else if(IR_ADC[IR_3]<IR_ADC_MIN[IR_3]){IR_ADC_MIN[IR_3]=IR_ADC[IR_3];}
			if(IR_ADC[IR_4]>IR_ADC_MAX[IR_4]){IR_ADC_MAX[IR_4]=IR_ADC[IR_4];}
			else if(IR_ADC[IR_4]<IR_ADC_MIN[IR_4]){IR_ADC_MIN[IR_4]=IR_ADC[IR_4];}
			if(IR_ADC[IR_5]>IR_ADC_MAX[IR_5]){IR_ADC_MAX[IR_5]=IR_ADC[IR_5];}
			else if(IR_ADC[IR_5]<IR_ADC_MIN[IR_5]){IR_ADC_MIN[IR_5]=IR_ADC[IR_5];}
			
			if(IR_ADC_MAX[IR_0]>4095){IR_ADC_MAX[IR_0]=4095;}
			else if(IR_ADC_MAX[IR_0]<0){IR_ADC_MAX[IR_0]=0;}
			if(IR_ADC_MAX[IR_1]>4095){IR_ADC_MAX[IR_1]=4095;}
			else if(IR_ADC_MAX[IR_1]<0){IR_ADC_MAX[IR_1]=0;}
			if(IR_ADC_MAX[IR_2]>4095){IR_ADC_MAX[IR_2]=4095;}
			else if(IR_ADC_MAX[IR_2]<0){IR_ADC_MAX[IR_2]=0;}
			if(IR_ADC_MAX[IR_3]>4095){IR_ADC_MAX[IR_3]=4095;}
			else if(IR_ADC_MAX[IR_3]<0){IR_ADC_MAX[IR_3]=0;}
			if(IR_ADC_MAX[IR_4]>4095){IR_ADC_MAX[IR_4]=4095;}
			else if(IR_ADC_MAX[IR_4]<0){IR_ADC_MAX[IR_4]=0;}
			if(IR_ADC_MAX[IR_5]>4095){IR_ADC_MAX[IR_5]=4095;}
			else if(IR_ADC_MAX[IR_5]<0){IR_ADC_MAX[IR_5]=0;}
		}
	}
}
void Aegulate_ADC(void)
{
	IR_ADC_A[IR_0] = (((Y_MAX-Y_MIN)/(IR_ADC_MAX[IR_0]-IR_ADC_MIN[IR_0]))*(IR_ADC[IR_0]-IR_ADC_MIN[IR_0]));
	IR_ADC_A[IR_1] = (((Y_MAX-Y_MIN)/(IR_ADC_MAX[IR_1]-IR_ADC_MIN[IR_1]))*(IR_ADC[IR_1]-IR_ADC_MIN[IR_1]));
	IR_ADC_A[IR_2] = (((Y_MAX-Y_MIN)/(IR_ADC_MAX[IR_2]-IR_ADC_MIN[IR_2]))*(IR_ADC[IR_2]-IR_ADC_MIN[IR_2]));
	IR_ADC_A[IR_3] = (((Y_MAX-Y_MIN)/(IR_ADC_MAX[IR_3]-IR_ADC_MIN[IR_3]))*(IR_ADC[IR_3]-IR_ADC_MIN[IR_3]));
	IR_ADC_A[IR_4] = (((Y_MAX-Y_MIN)/(IR_ADC_MAX[IR_4]-IR_ADC_MIN[IR_4]))*(IR_ADC[IR_4]-IR_ADC_MIN[IR_4]));
	IR_ADC_A[IR_5] = (((Y_MAX-Y_MIN)/(IR_ADC_MAX[IR_5]-IR_ADC_MIN[IR_5]))*(IR_ADC[IR_5]-IR_ADC_MIN[IR_5]));
	
	if(IR_ADC_A[IR_0]>Y_MAX){IR_ADC_A[IR_0]=Y_MAX;}
	else if(IR_ADC_A[IR_0]<Y_MIN){IR_ADC_A[IR_0]=Y_MIN;}
	if(IR_ADC_A[IR_1]>Y_MAX){IR_ADC_A[IR_1]=Y_MAX;}
	else if(IR_ADC_A[IR_1]<Y_MIN){IR_ADC_A[IR_1]=Y_MIN;}
	if(IR_ADC_A[IR_2]>Y_MAX){IR_ADC_A[IR_2]=Y_MAX;}
	else if(IR_ADC_A[IR_2]<Y_MIN){IR_ADC_A[IR_2]=Y_MIN;}
	if(IR_ADC_A[IR_3]>Y_MAX){IR_ADC_A[IR_3]=Y_MAX;}
	else if(IR_ADC_A[IR_3]<Y_MIN){IR_ADC_A[IR_3]=Y_MIN;}
	if(IR_ADC_A[IR_4]>Y_MAX){IR_ADC_A[IR_4]=Y_MAX;}
	else if(IR_ADC_A[IR_4]<Y_MIN){IR_ADC_A[IR_4]=Y_MIN;}
	if(IR_ADC_A[IR_5]>Y_MAX){IR_ADC_A[IR_5]=Y_MAX;}
	else if(IR_ADC_A[IR_5]<Y_MIN){IR_ADC_A[IR_5]=Y_MIN;}
}
void Power_weight(void)
{
	Deviation = (((-1.5)*IR_ADC_A[IR_1]+(-0.5)*IR_ADC_A[IR_2]+(0.5)*IR_ADC_A[IR_3]+(1.5)*IR_ADC_A[IR_4])/(IR_ADC_A[IR_1]+IR_ADC_A[IR_2]+IR_ADC_A[IR_3]+IR_ADC_A[IR_4]));
	
	if((IR_ADC_A[IR_1]>IR_ADC_A[IR_2])&&(IR_ADC_A[IR_1]>(3500))&&(IR_ADC_A[IR_2]<(350)))
	{
		Deviation=-1.4;
	}
	else if((IR_ADC_A[IR_4]>IR_ADC_A[IR_3])&&(IR_ADC_A[IR_4]>(3500))&&(IR_ADC_A[IR_3]<(350)))
	{
		Deviation=1.4;
	}
	
	if(Deviation>1.4)
	{
		Deviation=1.4;
	}
	else if(Deviation<-1.4)
	{
		Deviation=-1.4;
	}
}
/*----------------------���ʦ^��---------------------------*/
void Move(void)
{
	//PD����
	V_encoder=(E_R_V + E_L_V);
	D_encoder+=(V_encoder/2);
	W_encoder=(E_R_V - E_L_V);
	Sita_encoder+=W_encoder;
	//�M�u
	if(Choose_R==2)
	{
		//�a�ϸ�T
		Map_D+=(V_encoder/2);
		if(RUN_Mark==1)
		{	
			Start_D+=(V_encoder/2);
		}
		Map_R=MAP_E_R-MAP_E_L;
		if(Map_R<0)
		{
			Map_R=-Map_R;
		}
		if(Map_R>Map_R_Max)
		{
			Map_D_Mark=Map_D;
			Map_R_Max=Map_R;
		}
	}
	//�Ĩ뤽���ƧP�_
	else if(Choose_R==4)
	{
		Sprint_D_encoder+=(V_encoder/2);
	}
}


/*----------------------���FPD����-------------------------*/
void IR_PD_Control(void)
{
	IR_encoder_p=(Center-(Deviation*100));
	IR_encoder_d=(IR_encoder_p-IR_late_x);
	IR_late_x=IR_encoder_p;
	IR_PD_Command=(IR_encoder_p*IR_KP+IR_encoder_d*IR_KD);
	IR_PD+=IR_PD_Command;
}
void Vc_Command(void)
{
	if(Vc<Vn)
	{
		if(Vc>=Vmin&&Vc<=Vmax)
		{
			//�ܥ[�t��
			A_Change=((Vc-Vmin)*(Amin-Amax)/(Vmax-Vmin))+Amax;
			if(A_Change<=Amin)
			{
				A_Change=Amin;
			}
			else if(A_Change>=Amax)
			{
				A_Change=Amax;
			}
			
			Vc+=A_Change;
		}
		else
		{
			Vc+=Acc_add;
		}
		
		if(Vc>=Vn)
		{
			Vc=Vn;
		}
	}
	else if(Vc>Vn)
	{
		Vc-=A;
		if(Vc<=Vn)
		{
			Vc=Vn;
		}	
	}
	D_Command+=Vc;
}

void Vc_PD_Control(void)
{
	Vc_encoder_p=((D_Command*mm_pulse)-D_encoder);
	Vc_encoder_d=(Vc_encoder_p-Vc_late_x);
	Vc_late_x=Vc_encoder_p;
	Vc_PD_Command=(Vc_encoder_p*Vc_KP+Vc_encoder_d*Vc_KD);
}
void W_Command(void)
{
	if(Ws<Wn)
	{
		Ws+=A;
		if(Ws>=Wn)
		{
			Ws=Wn;
		}
	}
	else if(Ws>Wn)
	{
		Ws-=A;
		if(Ws<=Wn)
		{
			Ws=Wn;
		}
	}
	Sita_Command+=Ws;
}

void W_PD_Control(void)
{
	W_encoder_p=(IR_PD-Sita_encoder);
	W_encoder_d=(W_encoder_p-W_late_x);
	W_late_x=W_encoder_p;
	W_PD_Command=(W_encoder_p*W_KP+W_encoder_d*W_KD);
}
/*----------------------���p�P�_---------------------------*/
void Safe(void)
{
	if(IR_ADC_A[IR_1]<(Y_MAX*0.15) && IR_ADC_A[IR_2]<(Y_MAX*0.15) && IR_ADC_A[IR_3]<(Y_MAX*0.15) && IR_ADC_A[IR_4]<(Y_MAX*0.15))
	{
		Safer_time++;
		if(Safer_time>=SAFE_TIME)
		{
			GPIO_SetBits(GPIOC,GPIO_Pin_6);
			GPIO_SetBits(GPIOC,GPIO_Pin_9);
			TIM8->CCR2 = 3599;
			TIM8->CCR3 = 3599;
			Wind_MOTER(0);
			Buzzer_F=1;
			Clear();
			Safer_time=0;
			Safer_F=0;
			mode=0;
			Menu_F=0;
		}
	}
	else
	{
		Safer_time=0;
	}
}
void Cross(void)
{
	//�Q�r��		
	if(S_f==1)
	{
		if((D_encoder*pulse_mm)>=(S_D+S_Distance))
		{
			S_D=0;
			S_f=0;
		}
	}
	else
	{
		if(IR_ADC_A[IR_1]>=(Y_MAX*0.3)&&IR_ADC_A[IR_2]>=(Y_MAX*0.3)&&IR_ADC_A[IR_3]>=(Y_MAX*0.3)&&IR_ADC_A[IR_4]>=(Y_MAX*0.3))
		{
//			Buzzer_F=1;
			S_D=D_encoder*pulse_mm;
			S_f=1;
		}
	}
}
void Start_Direction(void)
{
	if(Direction_f==0)
	{
		//���]
		if(R_Point>=(Y_MAX*0.3))
		{
			Direction_R=1;
		}
		else if(Direction_R==1 && (R_Point<=(Y_MAX*0.25)))
		{
			Buzzer_F=1;
			RUN_Mark++;
			Direction_f=1;
			Direction_R=0;
		}
		
		//�϶]
		/*
		if(L_Point>=(Y_MAX*0.3))
		{
			Direction_L=1;
		}
		else if(Direction_L==1 && (L_Point<=(Y_MAX*0.25)))
		{
			Buzzer_F=1;
			RUN_Mark++;
			Direction_f=2;
			Direction_L=0;
		}
		*/
	}
}
