void Search(float Wind_Speed,float KP,float KD,float V)
{
	IR_KD=KD;
	IR_KP=KP;
	Aegulate_ADC();
	Power_weight();
	Move();
	//�l�u�@��
	if(mode==0)
	{
		Wind_MOTER(Wind_Speed);
		time++;
		if(time>=1000)
		{
			Vn=V;
			time=0;
			mode=1;
		}
	}
	//�`�u
	else if(mode==1)
	{
		//***************************��m���A*********************************//
		//�_�I�e
		if(RUN_Mark==0)
		{
			MAP_E_R=0;
			MAP_E_L=0;
			Start_D=0;
			Map_D=0;
			Map_R=0;
			Map_D_Mark=0;
			Map_R_Max=0;
			MAP_Mark=0;
			//�P�_��V
			Start_Direction();
		}
		//�j�M���a
		else if(RUN_Mark==1)
		{
			//�P�_�O�_�i�Q�r
			Cross();
			if(S_f==0)
			{
				//���ܲŸ�
				Search_MAP_Point();
				//���I�Ÿ�
				/*
				if((Start_D*pulse_mm)>=800)
				{
					
				}	
				*/				
				Search_End_Point();	
			}
		}
		//�i���I
		else if(RUN_Mark==2)
		{
			//�����Z��
			if((D_encoder*pulse_mm)>=((End_D+Parking_Distance)-((Vc*Vc)/(2*A))))
			{
				Vn=0.0;
			}
			//���@���^���Ҧ�
			if(((D_encoder*pulse_mm)>=(End_D+Parking_Distance)) || Vc<=0.0)
			{
				time++;
				if(time>=1000)
				{
					Wind_MOTER(0);
					Buzzer_F=1;
					Vc=0;
					Clear();
					RUN_Mark=0;
					End_D=0;
					mode=0;
					time=0;
					Menu_F=5;
				}
			}
		}
		//�t�שR�O&&�t��PD����
		Vc_Command();
		Vc_PD_Control();
	}
	//���t�שR�O&���t��PD����
	IR_PD_Control();
	W_PD_Control();
	//���F����
	MOTOR_Control();
	//�O�@
	Safe();
}
/*----------------------�Ĩ�-------------------------------*/
void Sprint_Support_Point(void)
{
//���]
	if(Direction_f==1)
	{
		if(L_Point>=(Y_MAX*0.3))
		{
			MAP_f=1;
		}
		else if(MAP_f==1 && (L_Point<=(Y_MAX*0.25)))
		{
			DE1=fabs(Sprint_D_encoder-(Total_D[Array-2]*mm_pulse));
			DE2=fabs(Sprint_D_encoder-(Total_D[Array-1]*mm_pulse));
			DE3=fabs(Sprint_D_encoder-(Total_D[Array]*mm_pulse));
			
			if((DE2<=DE1)&&(DE2<=DE3))
			{
				Sprint_D_encoder=Total_D[Array-1]*mm_pulse;
			}
			else if((DE1<=DE2)&&(DE1<=DE3))
			{
				Sprint_D_encoder=Total_D[Array-2]*mm_pulse;
			}
			else if((DE3<=DE1)&&(DE3<=DE2))
			{
				Sprint_D_encoder=Total_D[Array]*mm_pulse;
			}
			
			MAP_E_R=0;
			MAP_E_L=0;
			Map_D=0;
			Map_R=0;
			
			MAP_f=0;
		}
	}
	
//�϶]
	else if(Direction_f==2)
	{
		if(R_Point>=(Y_MAX*0.3))
		{
			MAP_f=1;
		}
		else if(MAP_f==1 && (R_Point<=(Y_MAX*0.25)))
		{
			DE1=fabs(Sprint_D_encoder-(Total_D[Array-2]*mm_pulse));
			DE2=fabs(Sprint_D_encoder-(Total_D[Array-1]*mm_pulse));
			DE3=fabs(Sprint_D_encoder-(Total_D[Array]*mm_pulse));
			
			if((DE2<=DE1)&&(DE2<=DE3))
			{
				Sprint_D_encoder=Total_D[Array-1]*mm_pulse;
			}
			else if((DE1<=DE2)&&(DE1<=DE3))
			{
				Sprint_D_encoder=Total_D[Array-2]*mm_pulse;
			}
			else if((DE3<=DE1)&&(DE3<=DE2))
			{
				Sprint_D_encoder=Total_D[Array]*mm_pulse;
			}
			
			MAP_E_R=0;
			MAP_E_L=0;
			Map_D=0;
			Map_R=0;
			
			MAP_f=0;
		}
	}
}

void Sprint_End_Point(void)
{
//���]
	if(Direction_f==1)
	{
		if(R_Point>=(Y_MAX*0.3))
		{
			RUN_f=1;
		}
		else if(RUN_f==1 && (R_Point<=(Y_MAX*0.25)))
		{
			Buzzer_F=1;
			End_D=Sprint_D_encoder*pulse_mm;
			RUN_Mark++;
			RUN_f=0;
		}
	}
//�϶]
	else if(Direction_f==2)
	{
		if(L_Point>=(Y_MAX*0.3))
		{
			RUN_f=1;
		}
		else if(RUN_f==1 && (L_Point<=(Y_MAX*0.25)))
		{
			Buzzer_F=1;
			End_D=Sprint_D_encoder*pulse_mm;
			RUN_Mark++;
			RUN_f=0;
		}
	}
}

void Sprint(float Wind_Speed,float KP,float KD,float BF,float R10,float R15,float R20,float R25,float R30,float R35,float R40,float R50,float R60,float R70,float R80,float R90,float R100,float R200,float R300,float R500)
{
	IR_KD=KD;
	IR_KP=KP;
	Aegulate_ADC();
	Power_weight();
	Move();
	//�t�t
	if(mode==0)
	{
		if(Array_up<=MAP_Mark)
		{
			if(MAP_R[Array_up]>=500)
			{
				Sprint_Array[Array_up]=R500;
			}
			else if(MAP_R[Array_up]>=300)
			{
				Sprint_Array[Array_up]=R300;
			}
			else if(MAP_R[Array_up]>=200)
			{
				Sprint_Array[Array_up]=R200;
			}
			else if(MAP_R[Array_up]>=100)
			{
				Sprint_Array[Array_up]=R100;
			}
			else if(MAP_R[Array_up]>=90)
			{
				Sprint_Array[Array_up]=R90;
			}
			else if(MAP_R[Array_up]>=80)
			{
				Sprint_Array[Array_up]=R80;
			}
			else if(MAP_R[Array_up]>=70)
			{
				Sprint_Array[Array_up]=R70;
			}
			else if(MAP_R[Array_up]>=60)
			{
				Sprint_Array[Array_up]=R60;
			}
			else if(MAP_R[Array_up]>=50)
			{
				Sprint_Array[Array_up]=R50;
			}
			else if(MAP_R[Array_up]>=40)
			{
				Sprint_Array[Array_up]=R40;
			}
			else if(MAP_R[Array_up]>=35)
			{
				Sprint_Array[Array_up]=R35;
			}
			else if(MAP_R[Array_up]>=30)
			{
				Sprint_Array[Array_up]=R30;
			}
			else if(MAP_R[Array_up]>=25)
			{
				Sprint_Array[Array_up]=R25;
			}
			else if(MAP_R[Array_up]>=20)
			{
				Sprint_Array[Array_up]=R20;
			}
			else if(MAP_R[Array_up]>=15)
			{
				Sprint_Array[Array_up]=R15;
			}
			else if(MAP_R[Array_up]>0)
			{
				Sprint_Array[Array_up]=R10;
			}
			else
			{
				Sprint_Array[Array_up]=0;
			}
			
			if(MAP_D[Array_up]<95)
			{
				if(MAP_D[Array_up-1]<210)
				{
					if(R15>1.8)
					{
						Sprint_Array[Array_up-1]=R10;
						Sprint_Array[Array_up]=R10;
					}
					else
					{
						Sprint_Array[Array_up-1]=R15;
						Sprint_Array[Array_up]=R15;
					}
				}
			}
			
			if(Sprint_Array[Array_up]<=R50)
			{
				if(MAP_D[Array_up-1]<200)
				{
					if(Sprint_Array[Array_up-1]>Sprint_Array[Array_up])
					{
						Sprint_Array[Array_up-1]=Sprint_Array[Array_up];
					}
				}
			}
			
			Array_up++;
		}
		else
		{
			Array_up=0;
			mode++;
		}
	}
	//�u��
	else if(mode==1)
	{
		if(Optimization_Start==0)
		{
			Array_up=MAP_Mark;
			Optimization_Start=1;
		}
		else
		{
			if(Array_up>0)
			{
				if(Sprint_Array[Array_up]<Sprint_Array[Array_up-1])
				{
					Optimization_speed=sqrt((2*A*(MAP_D[Array_up-1]))+(Sprint_Array[Array_up]*Sprint_Array[Array_up]));
					if(Optimization_speed>=Sprint_Array[Array_up-1])
					{
						Sprint_Array[Array_up-1]=Sprint_Array[Array_up-1];
					}
					else if(Optimization_speed<=Sprint_Array[Array_up])
					{
						Sprint_Array[Array_up-1]=Sprint_Array[Array_up];
					}
					else
					{
						Sprint_Array[Array_up-1]=Optimization_speed;
					}
					
					Array_up--;
				}
				else
				{
					Array_up--;
				}
			}
			else
			{
				Optimization_Start=0;
				mode++;
			}
		}
	}
	//�l�u�@��
	else if(mode==2)
	{
		Wind_MOTER(Wind_Speed);
		time++;
		if(time>=1000)
		{
			time=0;
			mode++;
		}
	}
	//�Ĩ�
	else if(mode==3)
	{
		//***************************��m���A*********************************//
		//�_�I�e
		if(RUN_Mark==0)
		{
			Array=0;
			Vn=Sprint_Array[Array];
			Sprint_D_encoder=0;
			//�P�_���϶]
			Start_Direction();
		}
		//�Ĩ�
		else if(RUN_Mark==1)
		{
			//�P�_�O�_�i�Q�r
			Cross();
			//���b�Q�r		
			if(S_f==0)
			{
				//�ɤ�����
				Sprint_Support_Point();
				//�_�I���I�Ÿ�
				Sprint_End_Point();
			}
			
			//�����ƧP�_
			if(Sprint_D_encoder>=(Total_D[Array]*mm_pulse))
			{
				Array++;

				if(Sprint_Array[Array]>Sprint_Array[Array-1])
				{
					Delay_up_f=1;
				}
				else if(Sprint_Array[Array]==Sprint_Array[Array-1])
				{
					Vn=Sprint_Array[Array];
				}
			}
			//���e��t
			if(Sprint_Array[Array]>Sprint_Array[Array+1])
			{
				if(Sprint_D_encoder>=((Total_D[Array]-(60.0+(BF*(((Vc*Vc)-(Sprint_Array[Array+1]*Sprint_Array[Array+1]))/(2*A)))))*mm_pulse))//80.0
				{
					Vn=Sprint_Array[Array+1];
					if(Sprint_Array[Array+1]>Sprint_Array[Array+2])
					{
						Early_down_f=1;
					}
					else
					{
						Early_down_f=0;
					}
					Delay_up_f=0;
				}
			}
			if(Early_down_f==1)
			{
				if(Sprint_D_encoder>=((Total_D[Array+1]-(60.0+(BF*(((Vc*Vc)-(Sprint_Array[Array+2]*Sprint_Array[Array+2]))/(2*A)))))*mm_pulse))//80.0
				{
					Vn=Sprint_Array[Array+2];
					Early_down_f=0;
				}
				else
				{
					Early_down_f=0;
				}
			}
			//����[�t
			if(Delay_up_f==1)
			{
				if(Sprint_D_encoder>=((Total_D[Array-1]+80.0)*mm_pulse))//100.0
				{
					Vn=Sprint_Array[Array];
					Delay_up_f=0;
				}
			}
		}
		//�i���I
		else if(RUN_Mark>=2)
		{
			if(Array >= (MAP_Mark-1))
			{
				if((Sprint_D_encoder*pulse_mm)>=((End_D+Parking_Distance)-((Vc*Vc)/(2*A))))
				{
					Vn=0.0;
				}
				if(((Sprint_D_encoder*pulse_mm)>=(End_D+Parking_Distance)) || V_encoder<=0.0)
				{
					time++;
					if(time>=1000)
					{
						Wind_MOTER(0);
						Buzzer_F=1;
						Vc=0;
						Clear();
						RUN_Mark=0;
						End_D=0;
						mode=0;
						time=0;
						Menu_F=0;
					}
				}
			}
			else
			{
				RUN_Mark=1;
			}
		}
		//�t�שR�O&&�t��PD����
		Vc_Command();
		Vc_PD_Control();
	}
	//���t�שR�O&���t��PD����
	IR_PD_Control();
	W_PD_Control();
	//���F����
	MOTOR_Control();
	//�O�@
	Safe();
}
