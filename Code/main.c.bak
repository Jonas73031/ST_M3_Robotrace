int main(void)
{
	Init_RCC();
	Init_NVIC();
	Init_GPIO();
	Init_PWM();
	Init_M_PWM();
	Init_Systick();
	Init_ADC();
	Init_TIMER2();
	Init_UART();
	Init_BUZZER();
	Init_QEI();
	
	//FlashŪ�����~�u�ƭ�
	for(count=0;count<=5;count++)
	{
		IR_ADC_MAX[count]=*(u16 *)(IR_Address + 2 + count*4);
		IR_ADC_MIN[count]=*(u16 *)(IR_Address + count*4);
	}

	//FlashŪ���`�I��
	MAP_Mark=*(u16 *)(MAP_Mark_Address);
	
	//FlashŪ�����a��T
	for(count=0;count<500;count++)
	{
		MAP_R[count]=*(u16 *)(MAP_R_Address + count*2);
		MAP_D[count]=*(u16 *)(MAP_D_Address + count*2);
		Total_D[count]=Total_D[count-1]+MAP_D[count];
	}
	
	//����RGB	
	GPIO_SetBits(GPIOB,GPIO_Pin_0 | GPIO_Pin_1 | GPIO_Pin_5);	//L_G,L_B,R_B
	GPIO_SetBits(GPIOC,GPIO_Pin_5 | GPIO_Pin_12);							//L_R,R_R
	GPIO_SetBits(GPIOD,GPIO_Pin_2);														//R_G
	
	
	while(1)
	{
		Menu();
	}
}

/*----------------------���-------------------------------*/
void Menu(void)
{
	//***************************�}���i���*********************************//
	if(Menu_F==0)
	{
		Choose();
	}
	//***************************�P�_����{��*******************************//
	else if(Menu_F==1)
	{
		if(IR_ADC[0]>=2000 && IR_ADC[5]>=2000)
		{
			Buzzer_F=1;
			GPIO_SetBits(GPIOB,GPIO_Pin_0 | GPIO_Pin_1 | GPIO_Pin_5);		//L_G,L_B,R_B
			GPIO_SetBits(GPIOC,GPIO_Pin_5 | GPIO_Pin_12);								//L_R,R_R
			GPIO_SetBits(GPIOD,GPIO_Pin_2);															//R_G
			Clear();
			if(Choose_R==1&&Choose_L==1)
			{
				Menu_F=2;
			}
			else
			{
				Menu_F=3;
			}
			if(Choose_R==5&&Choose_L==6)
			{
				Menu_F=4;
			}
		}
	}
	//***************************�s�J���~�u�̰��̧C��***********************//
	else if(Menu_F==2)
	{
		if(((E_R+E_L)/2) <= (-1000))
		{
			//---------------EEPROM�M���}�C���--------------//		
			FLASH_Unlock();
			
			FLASH_ClearFlag(FLASH_FLAG_BSY | FLASH_FLAG_EOP | FLASH_FLAG_PGERR | FLASH_FLAG_WRPRTERR);
			
			FLASH_ErasePage(IR_Address);
			
			count=0;
			
			while(count<=5)
			{
				Flash_WriteValue=(((int)IR_ADC_MAX[count]<<16)+((int)IR_ADC_MIN[count]));
				if(FLASH_ProgramWord(IR_Address+count*4,Flash_WriteValue)==FLASH_COMPLETE)
				{
					count++;
				}
			}
			
			FLASH_Lock();																									//Flash�W��
			
			Flash_WriteValue=0;
			
			Buzzer_F=1;
			Clear();
			mode=0;
			Menu_F=0;
		}
	}
	//***********************UART�ǰe���a��T&���~�u��**********************//
	else if(Menu_F==4)
	{
		if(Uart_up<=MAP_Mark)
		{
			Uart_Num(Uart_up);
			Uart_Num(MAP_R[Uart_up]);
			Uart_Num(MAP_D[Uart_up]);
			Uart_Num(Total_D[Uart_up]);
			Uart_Num(Sprint_Array[Uart_up]*100);
			Uart_Sent('\n');

			Uart_up++;
		}
		else
		{
			Uart_Num(IR_ADC_MAX[IR_0]);
			Uart_Num(IR_ADC_MAX[IR_1]);
			Uart_Num(IR_ADC_MAX[IR_2]);
			Uart_Num(IR_ADC_MAX[IR_3]);
			Uart_Num(IR_ADC_MAX[IR_4]);
			Uart_Num(IR_ADC_MAX[IR_5]);
			Uart_Sent('\n');
			Uart_Num(IR_ADC_MIN[IR_0]);
			Uart_Num(IR_ADC_MIN[IR_1]);
			Uart_Num(IR_ADC_MIN[IR_2]);
			Uart_Num(IR_ADC_MIN[IR_3]);
			Uart_Num(IR_ADC_MIN[IR_4]);
			Uart_Num(IR_ADC_MIN[IR_5]);
			Uart_Sent('\n');
			
			Uart_up=0;
			Menu_F=0;
		}
	}
	//***************************�`�u�����q�����t***************************//
	else if(Menu_F==5)
	{
		//�`�I��
		FLASH_Unlock();						 																		//Flash����
		
		FLASH_ClearFlag(FLASH_FLAG_BSY | FLASH_FLAG_EOP | FLASH_FLAG_PGERR | FLASH_FLAG_WRPRTERR);
		
		FLASH_ErasePage(MAP_Mark_Address);
		
		while(FLASH_ProgramWord(MAP_Mark_Address, MAP_Mark)!=FLASH_COMPLETE);
		
		FLASH_Lock();																									//Flash�W��
		
		//�Z��
		FLASH_Unlock();						 																		//Flash����
		
		FLASH_ClearFlag(FLASH_FLAG_BSY | FLASH_FLAG_EOP | FLASH_FLAG_PGERR | FLASH_FLAG_WRPRTERR);
		
		FLASH_ErasePage(MAP_D_Address);
		
		Array_up=0;
		
		while(Array_up<=MAP_Mark)
		{
			if(FLASH_ProgramHalfWord(MAP_D_Address+Array_up*2,MAP_D[Array_up])==FLASH_COMPLETE)
			{
				Array_up++;
			}
		}
		
		FLASH_Lock();																									//Flash�W��
		
		//�b�|
		FLASH_Unlock();						 																		//Flash����
		
		FLASH_ClearFlag(FLASH_FLAG_BSY | FLASH_FLAG_EOP | FLASH_FLAG_PGERR | FLASH_FLAG_WRPRTERR);
		
		FLASH_ErasePage(MAP_R_Address);
		
		Array_up=0;
		
		while(Array_up<=MAP_Mark)
		{
			if(FLASH_ProgramHalfWord(MAP_R_Address+Array_up*2,MAP_R[Array_up])==FLASH_COMPLETE)
			{
				Array_up++;
			}
		}
		
		FLASH_Lock();																									//Flash�W��
		
		Menu_F=0;
	}
}

